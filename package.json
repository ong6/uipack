{
  "name": "uipack",
  "version": "0.1.0",
  "description": "React and SVG figure components for engineering write-ups: framed figures, lanes, nodes, connectors, animated packets.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js",
      "require": "./dist/static.cjs"
    },
    "./browser.css": "./dist/browser.css",
    "./theme.css": "./dist/theme.css",
    "./assets/manifest.json": "./assets/manifest.json",
    "./assets/objects/*": "./assets/objects/*",
    "./package.json": "./package.json",
    "./slides": {
      "types": "./dist/slides.d.ts",
      "import": "./dist/slides.js",
      "require": "./dist/slides.cjs"
    },
    "./slides.css": "./dist/slides.css",
    "./presentations": {
      "types": "./dist/presentations.d.ts",
      "import": "./dist/presentations.js",
      "require": "./dist/presentations.cjs"
    },
    "./presentations.css": "./dist/presentations.css",
    "./deck": {
      "types": "./dist/deck.d.ts",
      "import": "./dist/deck.js",
      "require": "./dist/deck.cjs"
    },
    "./deck.css": "./dist/deck.css",
    "./objects": {
      "types": "./dist/objects.d.ts",
      "import": "./dist/objects.js",
      "require": "./dist/objects.cjs"
    },
    "./objects.css": "./dist/objects.css",
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "import": "./dist/docs.js",
      "require": "./dist/docs.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./charts.css": "./dist/charts.css",
    "./article": {
      "types": "./dist/article.d.ts",
      "import": "./dist/article.js",
      "require": "./dist/article.cjs"
    },
    "./article.css": "./dist/article.css",
    "./mechanism": {
      "types": "./dist/mechanism.d.ts",
      "import": "./dist/mechanism.js",
      "require": "./dist/mechanism.cjs"
    },
    "./mechanism.css": "./dist/mechanism.css",
    "./web.css": "./dist/web.css",
    "./web-gutters.css": "./dist/web-gutters.css",
    "./fonts/*": "./dist/fonts/*",
    "./docs.css": "./dist/docs.css"
  },
  "files": [
    "dist",
    "assets",
    "docs/assets",
    "README.md",
    "LICENSE",
    "docs/*.md",
    "AGENTS.md",
    "CLAUDE.md",
    "src/README.md",
    "playground/README.md",
    "src/mechanism/kit/LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/build-css.ts",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepare": "npm run build",
    "test:e2e": "playwright test",
    "screenshots": "SHOTS=1 playwright test --project=chromium e2e/screenshots.spec.ts",
    "manifest": "tsx scripts/build-manifest.tsx"
  },
  "peerDependencies": {
    "gsap": "^3.15.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.186.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gsap": "^3.15.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ong6/uipack.git"
  },
  "homepage": "https://junxiong.dev/uipack",
  "keywords": [
    "react",
    "svg",
    "diagrams",
    "figures",
    "components",
    "design-system"
  ],
  "author": "Ong Jun Xiong",
  "license": "MIT",
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    }
  }
}
