{
  "name": "uipack",
  "version": "0.5.0",
  "description": "React and SVG figure components for engineering write-ups: framed figures, lanes, nodes, connectors, animated packets.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "default": "./dist/static.js"
    },
    "./browser.css": "./dist/browser.css",
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./assets/manifest.json": "./assets/manifest.json",
    "./assets/objects/*": "./assets/objects/*",
    "./package.json": "./package.json",
    "./slides": {
      "types": "./dist/slides.d.ts",
      "default": "./dist/slides.js"
    },
    "./slides.css": "./dist/slides.css",
    "./presentations": {
      "types": "./dist/presentations.d.ts",
      "default": "./dist/presentations.js"
    },
    "./presentations.css": "./dist/presentations.css",
    "./deck": {
      "types": "./dist/deck.d.ts",
      "default": "./dist/deck.js"
    },
    "./deck.css": "./dist/deck.css",
    "./objects": {
      "types": "./dist/objects.d.ts",
      "default": "./dist/objects.js"
    },
    "./objects.css": "./dist/objects.css",
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./docs": {
      "types": "./dist/docs.d.ts",
      "default": "./dist/docs.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "default": "./dist/charts.js"
    },
    "./charts.css": "./dist/charts.css",
    "./article": {
      "types": "./dist/article.d.ts",
      "default": "./dist/article.js"
    },
    "./article.css": "./dist/article.css",
    "./mechanism": {
      "types": "./dist/mechanism.d.ts",
      "default": "./dist/mechanism.js"
    },
    "./mechanism.css": "./dist/mechanism.css",
    "./web.css": "./dist/web.css",
    "./web-gutters.css": "./dist/web-gutters.css",
    "./fonts/*": "./dist/fonts/*",
    "./docs.css": "./dist/docs.css",
    "./grade": {
      "types": "./dist/grade.d.ts",
      "default": "./dist/grade.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "docs/assets",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE",
    "docs/*.md",
    "docs/system/*.md",
    "docs/system/*/*.md",
    "docs/recipes/*.md",
    "docs/specs/*.md",
    "docs/components/*.md",
    "docs/grading",
    "bin",
    "docs/agents/*.md",
    "skills",
    "scripts/check-spec.ts",
    "scripts/style-contract.ts",
    "scripts/site-model.ts",
    "examples/web-starter/*",
    "AGENTS.md",
    "CLAUDE.md",
    "src/README.md",
    "playground/README.md",
    "src/mechanism/kit/LICENSE"
  ],
  "bin": {
    "uipack-grade": "./bin/uipack-grade.mjs",
    "uipack-figure-check": "./bin/figure-check-cli.mjs"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/build-css.ts",
    "dev": "vite",
    "build:site": "vite build",
    "check:site": "tsx scripts/check-site.ts",
    "test": "vitest run",
    "test:affected": "node scripts/affected.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run lint && node scripts/affected.mjs --unit",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "shoot": "node scripts/shoot.mjs",
    "screenshots": "SHOTS=1 playwright test --project=chromium e2e/screenshots.spec.ts",
    "manifest": "tsx scripts/build-manifest.tsx",
    "attw": "attw --pack",
    "docs:sync": "tsx scripts/docs-sync.ts",
    "grade": "tsx scripts/grade.ts"
  },
  "peerDependencies": {
    "gsap": "^3.15.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gsap": "^3.15.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.187.0",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ong6/uipack.git"
  },
  "homepage": "https://ui.junxiong.dev",
  "keywords": [
    "react",
    "svg",
    "diagrams",
    "figures",
    "components",
    "design-system"
  ],
  "author": "Ong Jun Xiong",
  "license": "MIT",
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    }
  },
  "overrides": {
    "tsup": {
      "esbuild": "$esbuild"
    },
    "minimatch": "^11.0.5"
  }
}
